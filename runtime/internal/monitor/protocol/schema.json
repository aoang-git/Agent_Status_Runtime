{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-status-runtime.local/schema/3",
  "$ref": "#/$defs/input",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "producer_id",
        "event_id",
        "agent",
        "session_id",
        "state",
        "reported_basis"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "session_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "native_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "native_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "reported_basis": {
          "enum": [
            "native_event",
            "inferred",
            "self_report"
          ]
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "source_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "working",
            "tool_activity",
            "waiting_confirmation",
            "idle",
            "completed",
            "interrupted",
            "failed",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "working",
                  "tool_activity",
                  "waiting_confirmation",
                  "completed",
                  "interrupted",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "operation_id"
            ]
          }
        },
        {
          "dependencies": {
            "stream_id": [
              "source_sequence"
            ],
            "source_sequence": [
              "stream_id"
            ]
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "producer_id",
        "event_id",
        "agent",
        "session_namespace",
        "session_id",
        "kind",
        "data",
        "id",
        "received_at",
        "origin",
        "historical",
        "source_id"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "session_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "native_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "native_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "reported_basis": {
          "enum": [
            "native_event",
            "inferred",
            "self_report"
          ]
        },
        "stream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "source_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "session.observed",
            "input.observed",
            "message.observed",
            "tool.observed",
            "approval.observed",
            "lifecycle.observed",
            "state.reported",
            "source.health",
            "source.heartbeat"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "parent_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "stop_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "phase": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "call_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "decision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "message_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "parent_node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "health": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\u0000-\u001f-]+$"
            },
            "branch_changed": {
              "type": "boolean"
            },
            "has_tools": {
              "type": "boolean"
            }
          }
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "origin": {
          "enum": [
            "file",
            "external"
          ]
        },
        "historical": {
          "const": false
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "sequence_gap": {
          "type": "boolean"
        }
      }
    },
    "recent": {
      "type": "object",
      "required": [
        "schema",
        "epoch",
        "revision",
        "facts",
        "dropped"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "maxItems": 4096
        },
        "dropped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": [
        "schema",
        "epoch",
        "revision"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\u0000-\u001f-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
